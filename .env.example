# Portal sign-in (set these in Vercel → Environment Variables)
HILTON_PORTAL_USER=hilton
HILTON_PORTAL_PASSWORD=change-me-before-go-live
SESSION_SECRET=use-a-long-random-string-here

# Live guest count (public webhook)
HILTON_COUNT_URL=https://flows.2kvoiceai.com/webhook/hilton-guest-stays/count

# Guest processing (Vercel only — never expose to the browser)
WORKMATE_API_URL=https://workmate.2kvoiceai.com
WORKMATE_API_KEY=
WORKMATE_BASIC_AUTH_USER=workmate
WORKMATE_BASIC_AUTH_PASSWORD=
# alias also supported:
# WORKMATE_BASIC_AUTH_PASS=
